import React, { useState } from 'react';
import {
  Text,
  View,
  Button,
  StyleSheet,
  Modal,
  ScrollView,
  TouchableOpacity,
  TextInput,
  Alert
} from 'react-native';

export default function App() {
  const [verReceitaVisivel, setVerReceitaVisivel] = useState(false);
  const [adicionarReceitaVisivel, setAdicionarReceitaVisivel] = useState(false);

  const [nomeReceita, setNomeReceita] = useState('');
  const [ingredientes, setIngredientes] = useState('');
  const [modoPreparo, setModoPreparo] = useState('');

  const [receitaSelecionada, setReceitaSelecionada] = useState(null);

  const [receitas, setReceitas] = useState([
    {
      id: '1',
      nome: 'Macarrão ao Molho de Tomate',
      ingredientes:
        '250 g de macarrão\n3 tomates maduros\n2 dentes de alho\n1 colher de azeite\nSal, pimenta e manjericão a gosto',
      preparo:
        '1. Cozinhe o macarrão em água fervente com sal.\n\n2. Aqueça o azeite e refogue o alho.\n\n3. Adicione os tomates picados, tempere e cozinhe por 15 minutos.\n\n4. Misture o molho ao macarrão.\n\n5. Finalize com manjericão e sirva.'
    }
  ]);

  function limparCampos() {
    setNomeReceita('');
    setIngredientes('');
    setModoPreparo('');
  }

  function salvarReceita() {
    if (
      !nomeReceita.trim() ||
      !ingredientes.trim() ||
      !modoPreparo.trim()
    ) {
      Alert.alert(
        'Campos obrigatórios',
        'Preencha o nome, os ingredientes e o modo de preparo.'
      );
      return;
    }

    const novaReceita = {
      id: Date.now().toString(),
      nome: nomeReceita.trim(),
      ingredientes: ingredientes.trim(),
      preparo: modoPreparo.trim()
    };

    setReceitas((listaAtual) => [...listaAtual, novaReceita]);

    limparCampos();
    setAdicionarReceitaVisivel(false);

    Alert.alert('Sucesso!', 'Receita cadastrada com sucesso!');
  }

  function cancelarCadastro() {
    limparCampos();
    setAdicionarReceitaVisivel(false);
  }

  function abrirReceita(receita) {
    setReceitaSelecionada(receita);
    setVerReceitaVisivel(true);
  }

  return (
    <View style={styles.container}>
      <Text style={styles.title}>🍲 App de Receitas</Text>

      <Text style={styles.subtitle}>
        Colecione suas receitas preferidas
      </Text>

      <ScrollView
        style={styles.recipeList}
        contentContainerStyle={styles.recipeListContent}
      >
        {receitas.map((receita) => (
          <View key={receita.id} style={styles.recipeCard}>
            <Text style={styles.cardTitle}>
              🍽️ {receita.nome}
            </Text>

            <Button
              title="Ver Receita"
              onPress={() => abrirReceita(receita)}
              color="#D97706"
            />
          </View>
        ))}
      </ScrollView>

      {/* Modal para visualizar uma receita */}
      <Modal
        visible={verReceitaVisivel}
        animationType="slide"
        onRequestClose={() => setVerReceitaVisivel(false)}
      >
        <ScrollView contentContainerStyle={styles.modalContainer}>
          {receitaSelecionada && (
            <>
              <Text style={styles.recipeTitle}>
                🍝 {receitaSelecionada.nome}
              </Text>

              <Text style={styles.sectionTitle}>
                🥕 Ingredientes
              </Text>

              <Text style={styles.recipeText}>
                {receitaSelecionada.ingredientes}
              </Text>

              <Text style={styles.sectionTitle}>
                👨‍🍳 Modo de Preparo
              </Text>

              <Text style={styles.recipeText}>
                {receitaSelecionada.preparo}
              </Text>
            </>
          )}

          <View style={styles.closeButton}>
            <Button
              title="Fechar Receita"
              onPress={() => setVerReceitaVisivel(false)}
              color="#356859"
            />
          </View>
        </ScrollView>
      </Modal>

      {/* Modal para cadastrar uma nova receita */}
      <Modal
        visible={adicionarReceitaVisivel}
        animationType="slide"
        onRequestClose={cancelarCadastro}
      >
        <ScrollView
          contentContainerStyle={styles.modalContainer}
          keyboardShouldPersistTaps="handled"
        >
          <Text style={styles.recipeTitle}>
            📝 Nova Receita
          </Text>

          <Text style={styles.inputLabel}>
            Nome da Receita
          </Text>

          <TextInput
            style={styles.input}
            placeholder="Ex.: Bolo de Cenoura"
            placeholderTextColor="#9A887D"
            value={nomeReceita}
            onChangeText={setNomeReceita}
          />

          <Text style={styles.inputLabel}>
            Ingredientes
          </Text>

          <TextInput
            style={[styles.input, styles.multilineInput]}
            placeholder="Digite os ingredientes..."
            placeholderTextColor="#9A887D"
            value={ingredientes}
            onChangeText={setIngredientes}
            multiline={true}
            textAlignVertical="top"
          />

          <Text style={styles.inputLabel}>
            Modo de Preparo
          </Text>

          <TextInput
            style={[styles.input, styles.multilineInput]}
            placeholder="Descreva o passo a passo..."
            placeholderTextColor="#9A887D"
            value={modoPreparo}
            onChangeText={setModoPreparo}
            multiline={true}
            textAlignVertical="top"
          />

          <View style={styles.formButton}>
            <Button
              title="Salvar"
              onPress={salvarReceita}
              color="#356859"
            />
          </View>

          <View style={styles.formButton}>
            <Button
              title="Cancelar"
              onPress={cancelarCadastro}
              color="#D97706"
            />
          </View>
        </ScrollView>
      </Modal>

      {/* Botão flutuante para adicionar receita */}
      <TouchableOpacity
        style={styles.floatingButton}
        onPress={() => setAdicionarReceitaVisivel(true)}
        activeOpacity={0.7}
        accessibilityLabel="Adicionar receita"
        accessibilityRole="button"
      >
        <Text style={styles.plusText}>+</Text>
      </TouchableOpacity>
    </View>
  );
}

